@using Application.ViewModels.ProductModel
@model IEnumerable<ProductDto>

@{
    ViewData["Title"] = "Список продукции";
}

<div class="container">
    <div class="row">
        <!-- Кнопки над карточками -->
        <div class="col-md-12 mb-4 d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Create")" class="btn btn-create">Добавить новую продукцию</a>
        </div>

        <!-- Карточка с фильтром и поиском -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <h3 class="card-title">Фильтр и поиск</h3>
                <form asp-action="Index" method="get">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-5 col-md-6">
                            <label class="form-label" for="searchString">Наименование или модель</label>
                            <input type="text" id="searchString" class="custom-input"
                                   name="searchString"
                                   value="@ViewBag.SearchString"
                                   placeholder="Введите наименование или модель" />
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <label class="form-label" for="searchManufacturer">Производитель</label>
                            <select class="custom-select" id="searchManufacturer" name="searchManufacturer">
                                <option value="">Все производители</option>
                                @foreach (var manufacturer in ViewBag.Manufacturers)
                                {
                                    <option value="@manufacturer.Text"
                                            selected="@(ViewBag.SearchManufacturer == manufacturer.Text)">
                                        @manufacturer.Text
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-lg-3 col-md-12">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-search flex-grow-1">Применить</button>

                                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchString as string)
                                     || !string.IsNullOrWhiteSpace(ViewBag.SearchManufacturer as string))
                                {
                                    <a asp-action="Index" class="btn btn-reset" title="Сбросить фильтр">Сбросить</a>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Карточка со списком -->
        <div class="col-md-12">
            <div class="card">
                <h3 class="card-title">Список продукции</h3>
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "Name" ? "Name_desc" : "Name", searchString = ViewBag.SearchString, searchManufacturer = ViewBag.SearchManufacturer })">Наименование</a>
                                </th>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "Manufacturer" ? "Manufacturer_desc" : "Manufacturer", searchString = ViewBag.SearchString, searchManufacturer = ViewBag.SearchManufacturer })">Производитель</a>
                                </th>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "Model" ? "Model_desc" : "Model", searchString = ViewBag.SearchString, searchManufacturer = ViewBag.SearchManufacturer })">Модель</a>
                                </th>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "Cost" ? "Cost_desc" : "Cost", searchString = ViewBag.SearchString, searchManufacturer = ViewBag.SearchManufacturer })">Стоимость (¥)</a>
                                </th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td class="text-center">@(item.ManufacturersList.FirstOrDefault(m => m.Value == item.ManufacturerId.ToString())?.Text ?? "Не указан")</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Model)</td>
                                    <td class="text-center">@item.Cost.ToString("C0")</td>
                                    <td class="text-center">
                                        <a class="btn btn-sm btn-edit btn-icon-only" asp-action="Edit" asp-route-id="@item.Id"
                                           asp-route-page="@ViewBag.CurrentPage"
                                           asp-route-searchString="@ViewBag.SearchString"
                                           asp-route-searchManufacturer="@ViewBag.SearchManufacturer"
                                           asp-route-sortOrder="@ViewBag.SortOrder"
                                           title="Изменить"></a>
                                        <a class="btn btn-sm btn-delete btn-icon-only" asp-action="Delete" asp-route-id="@item.Id"
                                           asp-route-page="@ViewBag.CurrentPage"
                                           asp-route-searchString="@ViewBag.SearchString"
                                           asp-route-searchManufacturer="@ViewBag.SearchManufacturer"
                                           asp-route-sortOrder="@ViewBag.SortOrder"
                                           title="Удалить"></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Пагинация -->
        @if (ViewBag.Paging != null)
        {
            <partial name="_Pagination" model="@ViewBag.Paging" />
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}