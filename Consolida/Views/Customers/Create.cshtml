@using Application.ViewModels.CustomerModel
@model CustomerDto

@{
    ViewData["Title"] = "Создание нового клиента";
}

<div class="container">
    <div class="row">
        <div class="col-md-12 mb-4">
            <a asp-action="Index" class="btn btn-go-to">Вернуться к списку клиентов</a>
        </div>

        <div class="col-md-12">
            <div class="card">
                <h3 class="card-title">Создание нового клиента</h3>
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-4">
                        <label class="form-label" for="CompanyId">@Html.DisplayNameFor(m => m.CompanyId)</label>
                        <select class="custom-select" asp-items="@Model.CompaniesList" asp-for="@Model.CompanyId"></select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="PreferredMethod">@Html.DisplayNameFor(m => m.PreferredMethod)</label>
                        <select class="custom-select" asp-items="@Model.PreferredMethodsList" asp-for="@Model.PreferredMethod"></select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LastName" class="form-label">@Html.DisplayNameFor(m => m.LastName)</label>
                        <input asp-for="LastName" class="custom-input" placeholder="Введите фамилию клиента" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FirstName" class="form-label">@Html.DisplayNameFor(m => m.FirstName)</label>
                        <input asp-for="FirstName" class="custom-input" placeholder="Введите имя клиента" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MiddleName" class="form-label">@Html.DisplayNameFor(m => m.MiddleName)</label>
                        <input asp-for="MiddleName" class="custom-input" placeholder="Введите отчество клиента" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="PositionJob" class="form-label">@Html.DisplayNameFor(m => m.PositionJob)</label>
                        <input asp-for="PositionJob" class="custom-input" placeholder="Введите должность" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label">@Html.DisplayNameFor(m => m.Email)</label>
                        <input asp-for="Email" class="custom-input" placeholder="Введите email клиента" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Phone" class="form-label">@Html.DisplayNameFor(m => m.Phone)</label>
                        <input asp-for="Phone" class="custom-input" placeholder="Введите телефон клиента" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-create">Создать запись</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}