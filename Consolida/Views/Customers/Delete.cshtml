@using Application.ViewModels.CustomerModel
@model CustomerDto

@{
    ViewData["Title"] = "Удаление клиента " + "\"" + Model.FirstName + " " + Model.LastName + "\"";
}

<div class="container">
    <div class="row">
        <div class="col-md-12 mb-4 d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-edit">Редактировать</a>
            <a asp-action="Index"
               asp-route-page="@ViewBag.ReturnPage"
               asp-route-searchStringCompany="@ViewBag.SearchStringCompany"
               asp-route-searchStringFirstName="@ViewBag.SearchStringFirstName"
               asp-route-searchStringLastName="@ViewBag.SearchStringLastName"
               asp-route-sortOrder="@ViewBag.SortOrder"
               class="btn btn-go-to">Вернуться к списку клиентов</a>
        </div>

        <div class="col-md-12">
            <div class="alert alert-warning text-center" role="alert">
                <h4>ВНИМАНИЕ! При удалении клиента будут удалены все связанные с этим клиентом заказы!</h4>
                <p class="mb-0"><strong>Вы уверены, что хотите удалить данную запись?</strong></p>
            </div>
        </div>

        <div class="col-md-12">
            <div class="card">
                <h3 class="card-title">Информация о клиенте</h3>

                <dl class="row mb-0">
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FirstName):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastName):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PositionJob):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.PositionJob)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Phone):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PreferredMethod):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.PreferredMethod)</dd>
                </dl>

                <form asp-action="DeleteConfirmed" method="post" class="text-center mt-4">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="page" value="@ViewBag.ReturnPage" />
                    <input type="hidden" name="searchStringCompany" value="@ViewBag.SearchStringCompany" />
                    <input type="hidden" name="searchStringFirstName" value="@ViewBag.SearchStringFirstName" />
                    <input type="hidden" name="searchStringLastName" value="@ViewBag.SearchStringLastName" />
                    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
                    <button type="submit" class="btn btn-delete">Удалить запись</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}