@using Application.ViewModels.TaxTypeModel
@model IEnumerable<TaxTypeDto>

@{
    ViewData["Title"] = "Список налогов и сборов";
}

<div class="container">
    <div class="row">
        <!-- Кнопки над карточками -->
        <div class="col-md-12 mb-4 d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Create")" class="btn btn-create">Добавить новый налог</a>
        </div>

        <!-- Карточка с фильтром и поиском -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <h3 class="card-title">Фильтр и поиск</h3>
                <form asp-action="Index" method="get">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label" for="SearchString">Наименование налога</label>
                            <input type="text" id="SearchString" class="custom-input"
                                   name="SearchString"
                                   value="@ViewBag.SearchString"
                                   placeholder="Введите наименование налога" />
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <label class="form-label" for="searchStringMeasureUnit">Единица измерения</label>
                            <input type="text" id="searchStringMeasureUnit" class="custom-input"
                                   name="searchStringMeasureUnit"
                                   value="@ViewBag.SearchStringMeasureUnit"
                                   placeholder="Введите единицу измерения" />
                        </div>

                        <div class="col-lg-4 col-md-12">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-search flex-grow-1">Применить</button>

                                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchString as string)
                                     || !string.IsNullOrWhiteSpace(ViewBag.SearchStringMeasureUnit as string))
                                {
                                    <a asp-action="Index" class="btn btn-reset" title="Сбросить фильтр">Сбросить</a>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Карточка со списком -->
        <div class="col-md-12">
            <div class="card">
                <h3 class="card-title">Список налогов</h3>
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "Name" ? "Name_desc" : "Name", searchString = ViewBag.SearchString, searchStringMeasureUnit = ViewBag.SearchStringMeasureUnit })">Наименование</a>
                                </th>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "Cost" ? "Cost_desc" : "Cost", searchString = ViewBag.SearchString, searchStringMeasureUnit = ViewBag.SearchStringMeasureUnit })">Стоимость</a>
                                </th>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "MeasureUnit" ? "MeasureUnit_desc" : "MeasureUnit", searchString = ViewBag.SearchString, searchStringMeasureUnit = ViewBag.SearchStringMeasureUnit })">Единица измерения</a>
                                </th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Cost)</td>
                                    <td class="text-center">@item.MeasureUnitsList.FirstOrDefault(c => c.Value == item.MeasureUnitId.ToString())?.Text</td>
                                    <td class="text-center">
                                        <a class="btn btn-sm btn-edit me-2" asp-action="Edit" asp-route-id="@item.Id"
                                           asp-route-page="@ViewBag.CurrentPage"
                                           asp-route-searchString="@ViewBag.SearchString"
                                           asp-route-searchStringMeasureUnit="@ViewBag.SearchStringMeasureUnit"
                                           asp-route-sortOrder="@ViewBag.SortOrder">Изменить</a>
                                        <a class="btn btn-sm btn-delete" asp-action="Delete" asp-route-id="@item.Id"
                                           asp-route-page="@ViewBag.CurrentPage"
                                           asp-route-searchString="@ViewBag.SearchString"
                                           asp-route-searchStringMeasureUnit="@ViewBag.SearchStringMeasureUnit"
                                           asp-route-sortOrder="@ViewBag.SortOrder">Удалить</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Пагинация -->
        @if (ViewBag.Paging != null)
        {
            <partial name="_Pagination" model="@ViewBag.Paging" />
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}