@using Application.ViewModels.CompanyModel
@model IEnumerable<CompanyDto>

@{
    ViewData["Title"] = "Список компаний";
}

<div class="container">
    <div class="row">
        <!-- Кнопки над карточками -->
        <div class="col-md-12 mb-4 d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Create")" class="btn btn-create">Добавить новую компанию</a>
            <a href="@Url.Action("Index", "Cities")" class="btn btn-go-to">Перейти к странице городов</a>
        </div>

        <!-- Карточка с фильтром и поиском -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <h3 class="card-title">Фильтр и поиск</h3>
                <form asp-action="Index" method="get">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="searchStringCompany">Поиск по наименованию компании</label>
                            <input type="text" id="searchStringCompany" class="custom-input" name="searchStringCompany"
                                   value="@ViewBag.SearchStringCompany"
                                   placeholder="Введите наименование компании" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="searchStringCity">Поиск по наименованию города</label>
                            <input type="text" id="searchStringCity" class="custom-input" name="searchStringCity"
                                   value="@ViewBag.SearchStringCity"
                                   placeholder="Введите наименование города" />
                        </div>

                        <div class="col-md-4">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-search flex-grow-1">Применить фильтр</button>

                                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchStringCompany as string)
                                     || !string.IsNullOrWhiteSpace(ViewBag.SearchStringCity as string))
                                {
                                    <a asp-action="Index" class="btn btn-reset" title="Сбросить фильтр">Сбросить</a>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Карточка со списком -->
        <div class="col-md-12">
            <div class="card">
                <h3 class="card-title">Список компаний</h3>
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "Name" ? "Name_desc" : "Name", searchStringCompany = ViewBag.SearchStringCompany, searchStringCity = ViewBag.SearchStringCity })">Наименование</a>
                                </th>
                                <th class="text-center">
                                    <a href="@Url.Action("Index", new { sortOrder = ViewBag.SortOrder == "City" ? "City_desc" : "City", searchStringCompany = ViewBag.SearchStringCompany, searchStringCity = ViewBag.SearchStringCity })">Город</a>
                                </th>
                                <th class="text-center">Адрес</th>
                                <th class="text-center">Страна</th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td class="text-center">@item.CitiesList.FirstOrDefault(c => c.Value == item.CityId.ToString())?.Text</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Address)</td>
                                    <td class="text-center">@item.Country.GetDisplayName()</td>
                                    <td class="text-center">
                                        <a class="btn btn-sm btn-edit me-2" asp-action="Edit" asp-route-id="@item.Id"
                                           asp-route-page="@ViewBag.CurrentPage"
                                           asp-route-searchStringCompany="@ViewBag.SearchStringCompany"
                                           asp-route-searchStringCity="@ViewBag.SearchStringCity"
                                           asp-route-sortOrder="@ViewBag.SortOrder">Изменить</a>

                                        <a class="btn btn-sm btn-delete" asp-action="Delete" asp-route-id="@item.Id"
                                           asp-route-page="@ViewBag.CurrentPage"
                                           asp-route-searchStringCompany="@ViewBag.SearchStringCompany"
                                           asp-route-searchStringCity="@ViewBag.SearchStringCity"
                                           asp-route-sortOrder="@ViewBag.SortOrder">Удалить</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Пагинация -->
        @if (ViewBag.Paging != null)
        {
            <partial name="_Pagination" model="@ViewBag.Paging" />
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}