@using Application.ViewModels.CompanyModel
@model CompanyDto

@{
    ViewData["Title"] = "Удаление компании " + "\"" + Model.Name + "\"";
}

<div class="container">
    <div class="row">
        <div class="col-md-12 mb-4 d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-edit">Редактировать</a>
            <a asp-action="Index"
               asp-route-page="@ViewBag.ReturnPage"
               asp-route-searchStringCompany="@ViewBag.SearchStringCompany"
               asp-route-searchStringCity="@ViewBag.SearchStringCity"
               asp-route-sortOrder="@ViewBag.SortOrder"
               class="btn btn-go-to">Вернуться к списку компаний</a>
        </div>

        <div class="col-md-12">
            <div class="alert alert-warning text-center" role="alert">
                <h4>ВНИМАНИЕ! При удалении компании будут удалены все связанные с этой компанией клиенты и их заказы!</h4>
                <p class="mb-0"><strong>Вы уверены, что хотите удалить данную запись?</strong></p>
            </div>
        </div>

        <div class="col-md-12">
            <div class="card">
                <h3 class="card-title">Информация о компании</h3>

                <dl class="row mb-0">
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Country):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Country)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Address):</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>
                </dl>

                <form asp-action="DeleteConfirmed" method="post" class="text-center mt-4">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="page" value="@ViewBag.ReturnPage" />
                    <input type="hidden" name="searchStringCompany" value="@ViewBag.SearchStringCompany" />
                    <input type="hidden" name="searchStringCity" value="@ViewBag.SearchStringCity" />
                    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
                    <button type="submit" class="btn btn-delete">Удалить запись</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}