@using DB.Entity.Enum
@using Application.ViewModels.ConsolidationModel
@model ConsolidationPoolDto

@{
    bool isUrgent = Model.Status == Status.OnTheWay &&
                    Model.ExpectedDeliveryDate.HasValue &&
                    Model.ExpectedDeliveryDate.Value.Date <= DateTime.Now.AddDays(7).Date;
    bool isShipped = Model.Status == Status.Shipped;
    string cardClass = isShipped ? "pool-shipped" : (isUrgent ? "pool-urgent" : "");

    string statusClass = Model.Status switch
    {
        Status.OnTheWay => "status-ontheway",
        Status.Shipped => "status-shipped",
        _ => ""
    };
}

<div class="card pool-card tracking-pool-card @cardClass"
     style="--pool-color: @Model.Color;"
     data-pool-id="@Model.PoolId">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap" style="gap: 0.5rem;">
        <h5 class="mb-0">Отгрузка №@Model.PoolId</h5>
        <div class="d-flex align-items-center gap-2">
            <span class="badge">@Model.TargetWeek нед. · @Model.TotalWeight.ToString("N1") кг</span>
        </div>
    </div>
    <div class="card-body">
        <div class="pool-meta">
            <div class="pool-status-badge @statusClass">
                <span class="pool-status-dot"></span>
                @Model.Status.GetDisplayName()
            </div>
            @if (Model.ExpectedDeliveryDate.HasValue)
            {
                <div class="pool-delivery-date">
                    <span class="pool-delivery-label">Ожидаемая доставка:</span>
                    <span class="pool-delivery-value">@Model.ExpectedDeliveryDate.Value.ToString("dd.MM.yyyy")</span>
                </div>
            }
        </div>

        @foreach (var order in Model.Orders)
        {
            <div class="pool-order @(order.IsInactive ? "inactive" : "")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@order.OrderNumber</strong> — @order.CompanyName<br />
                        <span>@order.TotalWeight.ToString("N2") кг · @order.TotalCost.ToString("N2") ¥</span>
                    </div>
                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId"
                       class="btn btn-sm btn-details btn-icon-only"
                       title="Детали" aria-label="Детали"></a>
                </div>
            </div>
        }

        <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap" style="gap: 0.5rem;">
            <form method="post" asp-action="ReturnPoolToPaid"
                  asp-route-poolId="@Model.PoolId" class="m-0">
                <button type="submit" class="btn btn-sm btn-go-to">
                    Вернуть в оплаченные
                </button>
            </form>
        </div>
    </div>
</div>