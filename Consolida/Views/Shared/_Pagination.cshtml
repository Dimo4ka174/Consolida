@using Application.DataAccessLayer.Service.Common
@model PagingHelpers

<div class="container">
    @if (Model.TotalPages > 0)
    {
        <ul class="pagination custom-pagination">
            <!-- Кнопка "В начало" -->
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link btn-start-end start" href="@Url.Action("Index", GetFilterParameters(1))">В начало</a>
                </li>
            }

            <!-- Кнопка "Предыдущая" -->
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link btn-prev-next prev" href="@Url.Action("Index", GetFilterParameters(Model.CurrentPage - 1))"></a>
                </li>
            }

            <!-- Номера страниц -->
            @for (var pge = Model.StartPage; pge <= Model.EndPage; pge++)
            {
                var activeClass = pge == Model.CurrentPage ? "active" : "";
                <li class="page-item @activeClass">
                    <a class="page-link" href="@Url.Action("Index", GetFilterParameters(pge))">@pge</a>
                </li>
            }

            <!-- Кнопка "Следующая" -->
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link btn-prev-next next" href="@Url.Action("Index", GetFilterParameters(Model.CurrentPage + 1))"></a>
                </li>
            }

            <!-- Кнопка "В конец" -->
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link btn-start-end end" href="@Url.Action("Index", GetFilterParameters(Model.TotalPages))">В конец</a>
                </li>
            }
        </ul>
    }
</div>

@functions {
    private object GetFilterParameters(int page)
    {
        var filterParams = new Dictionary<string, object>();
        if (ViewBag.FilterParams is Dictionary<string, object> dict)
        {
            foreach (var kvp in dict)
            {
                filterParams[kvp.Key] = kvp.Value;
            }
        }
        filterParams["page"] = page;
        return filterParams;
    }
}