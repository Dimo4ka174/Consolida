@using DB.Authorization
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <a class="btn btn-header btn-header-secondary"
       asp-area="Identity" asp-page="/Account/Manage/Index"
       title="Профиль">
        <span class="mask-icon mask-icon-user"></span>
        <span>@(User.Identity?.Name ?? "Профиль")</span>
    </a>

    <form class="d-inline-flex" asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="btn btn-header btn-header-danger">
            <span class="mask-icon mask-icon-sign-out"></span>
            <span>Выход</span>
        </button>
    </form>
}
else
{
    <a class="btn btn-header btn-header-secondary"
       asp-area="Identity" asp-page="/Account/Register">
        <span class="mask-icon mask-icon-user-plus"></span>
        <span>Регистрация</span>
    </a>
    <a class="btn btn-header btn-header-primary"
       asp-area="Identity" asp-page="/Account/Login">
        <span class="mask-icon mask-icon-sign-in"></span>
        <span>Вход</span>
    </a>
}
