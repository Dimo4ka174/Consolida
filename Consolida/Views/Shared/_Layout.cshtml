@using DB.Authorization
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    var pageTitle = ViewData["Title"]?.ToString();
    var showHeaderTitle = !string.IsNullOrWhiteSpace(pageTitle) && pageTitle != "Home Page";
    var docTitle = string.IsNullOrWhiteSpace(pageTitle) ? "Consolida" : $"{pageTitle} — Consolida";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@docTitle</title>

    <!-- Тема применяется ДО отрисовки -->
    <script src="~/js/layout/theme.js"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.css" />
    <link rel="stylesheet" href="~/css/mainStyle/designTokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainStyle/baseStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainStyle/buttonStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainStyle/modalStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainStyle/headerStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainStyle/sliderStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainStyle/cardStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainStyle/paginationStyle.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="header col-12">
        <div class="container">
            <div class="header-card">
                <nav class="header-nav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <button type="button" class="sidebar-nav" id="sidebar-nav" aria-label="Меню">
                            <span class="hamburger-icon">
                                <span class="bar top-bar"></span>
                                <span class="bar middle-bar"></span>
                                <span class="bar bottom-bar"></span>
                            </span>
                        </button>
                    }

                    @if (showHeaderTitle)
                    {
                        <h1 class="header-title">@pageTitle</h1>
                    }
                    else
                    {
                        <div class="header-title-spacer"></div>
                    }

                    <div class="header-actions">
                        <a href="/" class="theme-toggle" aria-label="На главную" title="На главную">
                            <span class="mask-icon mask-icon-home"></span>
                        </a>

                        <button type="button" id="themeToggle" class="theme-toggle" aria-label="Переключить тему">
                            <span class="mask-icon mask-icon-moon theme-icon-moon"></span>
                            <span class="mask-icon mask-icon-sun theme-icon-sun"></span>
                        </button>

                        <partial name="_LoginPartial" />
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <div class="row">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <partial name="_Slider" />
        <main class="main col-12">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["Message"]
                </div>
            }
            <div class="col-md-12 main-content @(ViewBag.FullWidth == true ? "main-content-full" : "")" id="main-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="footer col-12">
        <div class="container">
            <hr class="footer-line" />
            <div class="footer-content">
                Consolida © @DateTime.Now.Year — <a href="/Home/Privacy">Конфиденциальность</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <script src="~/js/layout/slider.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
