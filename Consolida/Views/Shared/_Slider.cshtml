@inject SignInManager<ApplicationUser> SignInManager
@inject IAuthorizationService AuthorizationService
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using DB.Authorization

<div class="sidebar" id="sidebar">
    <nav class="sidebar-nav-wrapper">
        <ul class="sidebar-menu">

            @if ((await AuthorizationService.AuthorizeAsync(User, "ReadOrders")).Succeeded)
            {
                <li class="sidebar-item">
                    <a class="sidebar-btn @(Context.Request.Path.StartsWithSegments("/Orders") ? "active" : "")" href="/Orders">
                        <span class="mask-icon mask-icon-catalog"></span>
                        <span class="sidebar-btn-label">Заказы</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <button type="button" class="sidebar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="mask-icon mask-icon-box"></span>
                        <span class="sidebar-btn-label">Консолидация</span>
                    </button>
                    <ul class="dropdown-menu sidebar-dropdown">
                        <li>
                            <a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Consolidation") && !Context.Request.Path.StartsWithSegments("/Tracking") ? "active" : "")"
                               href="/Consolidation">Доска консолидации</a>
                        </li>
                        <li>
                            <a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Tracking") ? "active" : "")"
                               href="/Consolidation/Tracking">Отслеживание отгрузок</a>
                        </li>
                    </ul>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-btn @(Context.Request.Path.StartsWithSegments("/OrderNotifications") ? "active" : "")"
                       href="/OrderNotifications">
                        <span class="mask-icon mask-icon-bell"></span>
                        <span class="sidebar-btn-label">Напоминания</span>
                    </a>
                </li>
            }

            @if ((await AuthorizationService.AuthorizeAsync(User, "ReadCities")).Succeeded ||
                 (await AuthorizationService.AuthorizeAsync(User, "ReadCompanies")).Succeeded ||
                 (await AuthorizationService.AuthorizeAsync(User, "ReadCustomers")).Succeeded ||
                 (await AuthorizationService.AuthorizeAsync(User, "ReadManufacturers")).Succeeded ||
                 (await AuthorizationService.AuthorizeAsync(User, "ReadProducts")).Succeeded)
            {
                <li class="sidebar-item">
                    <button type="button" class="sidebar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="mask-icon mask-icon-kindle"></span>
                        <span class="sidebar-btn-label">Справочники</span>
                    </button>
                    <ul class="dropdown-menu sidebar-dropdown">
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadCities")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Cities") ? "active" : "")" href="/Cities">Города</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadCompanies")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Companies") ? "active" : "")" href="/Companies">Компании</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadCustomers")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Customers") ? "active" : "")" href="/Customers">Клиенты</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadManufacturers")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Manufacturers") ? "active" : "")" href="/Manufacturers">Производители</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadProducts")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Products") ? "active" : "")" href="/Products">Продукция</a></li>
                        }
                    </ul>
                </li>
            }

            @if ((await AuthorizationService.AuthorizeAsync(User, "ReadCodesTNVD")).Succeeded ||
                 (await AuthorizationService.AuthorizeAsync(User, "ReadMeasureUnits")).Succeeded ||
                 (await AuthorizationService.AuthorizeAsync(User, "ReadTaxTypes")).Succeeded)
            {
                <li class="sidebar-item">
                    <button type="button" class="sidebar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="mask-icon mask-icon-percent"></span>
                        <span class="sidebar-btn-label">Налоги</span>
                    </button>
                    <ul class="dropdown-menu sidebar-dropdown">
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadCodesTNVD")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/CodeTNVDs") ? "active" : "")" href="/CodeTNVDs">Коды ТН ВЭД</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadMeasureUnits")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/MeasureUnits") ? "active" : "")" href="/MeasureUnits">Единицы измерения</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "ReadTaxTypes")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/TaxTypes") ? "active" : "")" href="/TaxTypes">Налоги</a></li>
                        }
                    </ul>
                </li>
            }

            @if ((await AuthorizationService.AuthorizeAsync(User, "UserManager")).Succeeded ||
                 (await AuthorizationService.AuthorizeAsync(User, "RoleManager")).Succeeded)
            {
                <li class="sidebar-item">
                    <button type="button" class="sidebar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="mask-icon mask-icon-lock"></span>
                        <span class="sidebar-btn-label">Администрирование</span>
                    </button>
                    <ul class="dropdown-menu sidebar-dropdown">
                        @if ((await AuthorizationService.AuthorizeAsync(User, "RoleManager")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Roles") ? "active" : "")" href="/Roles">Список ролей</a></li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, "UserManager")).Succeeded)
                        {
                            <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Users") ? "active" : "")" href="/Users">Список пользователей</a></li>
                        }
                    </ul>
                </li>
            }

            <li class="sidebar-item">
                <button type="button" class="sidebar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="mask-icon mask-icon-identity"></span>
                    <span class="sidebar-btn-label">Аккаунт</span>
                </button>
                <ul class="dropdown-menu sidebar-dropdown">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Identity/Account/Manage") ? "active" : "")" asp-area="Identity" asp-page="/Account/Manage/Index">Профиль</a></li>
                        <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Identity/Account/Logout") ? "active" : "")" asp-area="Identity" asp-page="/Account/Logout">Выход</a></li>
                    }
                    else
                    {
                        <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Identity/Account/Login") ? "active" : "")" asp-area="Identity" asp-page="/Account/Login">Вход</a></li>
                        <li><a class="dropdown-item @(Context.Request.Path.StartsWithSegments("/Identity/Account/Register") ? "active" : "")" asp-area="Identity" asp-page="/Account/Register">Регистрация</a></li>
                    }
                </ul>
            </li>

        </ul>
    </nav>
</div>
