@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="container d-flex justify-content-center">
    <div class="row w-100">
        <div class="col-md-6 offset-md-3">
            <div class="card rounded-lg p-4">
                <h3 class="card-title text-center mb-4">Восстановление пароля</h3>
                <p class="text-center mb-4">Введите логин, и мы отправим инструкцию по сбросу пароля.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Логин</label>
                        <input asp-for="Input.Email" class="custom-input" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-create w-100">Отправить</button>

                    <div class="text-center mt-4">
                        <a asp-page="./Login">Вернуться к входу</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}