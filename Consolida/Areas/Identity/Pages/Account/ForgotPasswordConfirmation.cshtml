@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Письмо отправлено";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card rounded-lg p-4">
                <h3 class="card-title text-center mb-3">Проверьте почту</h3>
                <p class="text-center">
                    Если аккаунт с таким логином существует, на него отправлена инструкция по сбросу пароля.
                </p>
                <div class="text-center mt-3">
                    <a asp-page="./Login" class="btn btn-go-to">К странице входа</a>
                </div>
            </div>
        </div>
    </div>
</div>