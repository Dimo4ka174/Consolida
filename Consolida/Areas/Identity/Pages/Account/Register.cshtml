@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container d-flex justify-content-center">
    <div class="row w-100">
        <div class="col-md-6 offset-md-3">
            <div class="card rounded-lg p-4">
                <h3 class="card-title text-center mb-4">Создание нового аккаунта</h3>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Логин</label>
                        <input asp-for="Input.Email" class="custom-input" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Пароль</label>
                        <input asp-for="Input.Password" class="custom-input" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Подтвердите пароль</label>
                        <input asp-for="Input.ConfirmPassword" class="custom-input" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-create w-100">Зарегистрироваться</button>

                    <div class="text-center mt-4">
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Уже есть аккаунт? Войти</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}