@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Пароль изменён";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card rounded-lg p-4">
                <h3 class="card-title text-center mb-3">Пароль успешно изменён</h3>
                <p class="text-center">Теперь вы можете войти с новым паролем.</p>
                <div class="text-center mt-3">
                    <a asp-page="./Login" class="btn btn-create">Войти</a>
                </div>
            </div>
        </div>
    </div>
</div>