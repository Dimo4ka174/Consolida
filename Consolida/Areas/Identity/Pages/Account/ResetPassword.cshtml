@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Сброс пароля";
}

<div class="container d-flex justify-content-center">
    <div class="row w-100">
        <div class="col-md-6 offset-md-3">
            <div class="card rounded-lg p-4">
                <h3 class="card-title text-center mb-4">Новый пароль</h3>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <input asp-for="Input.Code" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Логин</label>
                        <input asp-for="Input.Email" class="custom-input" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Новый пароль</label>
                        <input asp-for="Input.Password" class="custom-input" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Подтвердите пароль</label>
                        <input asp-for="Input.ConfirmPassword" class="custom-input" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-create w-100">Сохранить</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}