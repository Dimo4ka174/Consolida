@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="container d-flex justify-content-center">
    <div class="row w-100">
        <div class="col-md-6 offset-md-3">
            <div class="card rounded-lg p-4">
                <h3 class="card-title text-center mb-4">Вход в систему</h3>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Логин</label>
                        <input asp-for="Input.Email" class="custom-input" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Пароль</label>
                        <input asp-for="Input.Password" class="custom-input" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Запомнить меня</label>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-create w-100">Войти</button>

                    <div class="text-center mt-4 d-flex flex-column gap-2">
                        <a asp-page="./ForgotPassword">Забыли пароль?</a>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Создать аккаунт</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}