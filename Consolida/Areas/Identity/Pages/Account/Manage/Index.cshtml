@page
@model IndexModel
@{
    ViewData["Title"] = "Профиль";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="profile-container">
    <div class="profile-nav-container">
        <div class="profile-nav">
            <h4 class="profile-nav-title">Настройки</h4>
            <partial name="_ManageNav" />
        </div>
    </div>

    <div class="profile-content-container">
        <div class="card rounded-lg p-4">
            <h3 class="card-title mb-3">@ViewData["Title"]</h3>
            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Логин</label>
                    <input asp-for="Username" class="custom-input" disabled />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.PhoneNumber" class="form-label">Телефон</label>
                    <input asp-for="Input.PhoneNumber" class="custom-input" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <button id="update-profile-button" type="submit" class="btn btn-create">Сохранить</button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Identity/manageProfile.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}