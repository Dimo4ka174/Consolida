@page
@model EmailModel
@{
    ViewData["Title"] = "Смена логина";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="profile-container">
    <div class="profile-nav-container">
        <div class="profile-nav">
            <h4 class="profile-nav-title">Настройки</h4>
            <partial name="_ManageNav" />
        </div>
    </div>

    <div class="profile-content-container">
        <div class="card rounded-lg p-4">
            <h3 class="card-title mb-3">@ViewData["Title"]</h3>
            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="email-form" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label for="current-email" class="form-label">Текущий логин</label>
                    <input id="current-email" value="@Model.Email" class="custom-input" disabled />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NewEmail" class="form-label">Новый логин</label>
                    <input asp-for="Input.NewEmail" class="custom-input" autocomplete="email" />
                    <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                </div>

                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-create">Изменить</button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Identity/manageProfile.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}