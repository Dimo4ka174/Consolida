@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Личные данные";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card rounded-lg p-4">
                <h3 class="card-title mb-3">Личные данные</h3>
                <p>Ваш аккаунт содержит личные данные, которые вы нам предоставили.</p>
                <p>
                    <strong>Удаление аккаунта необратимо. Восстановить его будет невозможно.</strong>
                </p>
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-delete">Удалить аккаунт</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
