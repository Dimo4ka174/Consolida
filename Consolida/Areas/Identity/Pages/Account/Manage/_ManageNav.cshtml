@using DB.Authorization;
@inject SignInManager<ApplicationUser> SignInManager

<ul class="profile-nav-list">
    <li class="profile-nav-item">
        <a class="profile-nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">Профиль</a>
    </li>
    <li class="profile-nav-item">
        <a class="profile-nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">Логин</a>
    </li>
    <li class="profile-nav-item">
        <a class="profile-nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">Пароль</a>
    </li>
    <li class="profile-nav-item">
        <a class="profile-nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">Личные данные</a>
    </li>
</ul>