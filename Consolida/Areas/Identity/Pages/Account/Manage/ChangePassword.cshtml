@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Смена пароля";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="profile-container">
    <div class="profile-nav-container">
        <div class="profile-nav">
            <h4 class="profile-nav-title">Настройки</h4>
            <partial name="_ManageNav" />
        </div>
    </div>

    <div class="profile-content-container">
        <div class="card rounded-lg p-4">
            <h3 class="card-title mb-3">@ViewData["Title"]</h3>
            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.OldPassword" class="form-label">Текущий пароль</label>
                    <input asp-for="Input.OldPassword" class="custom-input" autocomplete="current-password" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label">Новый пароль</label>
                    <input asp-for="Input.NewPassword" class="custom-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Подтвердите пароль</label>
                    <input asp-for="Input.ConfirmPassword" class="custom-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-create">Обновить пароль</button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Identity/manageProfile.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}