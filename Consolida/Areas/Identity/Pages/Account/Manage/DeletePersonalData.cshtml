@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Удаление аккаунта";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="profile-container">
    <div class="profile-nav-container">
        <div class="profile-nav">
            <h4 class="profile-nav-title">Настройки</h4>
            <partial name="_ManageNav" />
        </div>
    </div>

    <div class="profile-content-container">
        <div class="card rounded-lg p-4">
            <h3 class="card-title mb-3">@ViewData["Title"]</h3>

            <div class="alert alert-warning mb-4" role="alert">
                <strong>Удаление аккаунта необратимо. Восстановить его будет невозможно.</strong>
            </div>

            <form id="delete-user" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                @if (Model.RequirePassword)
                {
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Пароль</label>
                        <input asp-for="Input.Password" class="custom-input" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                }

                <button type="submit" class="btn btn-delete">Удалить аккаунт</button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Identity/manageProfile.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}