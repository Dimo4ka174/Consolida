@page
@model LogoutModel
@{
    ViewData["Title"] = "Выход";
}

<div class="container d-flex justify-content-center">
    <div class="row w-100">
        <div class="col-md-6 offset-md-3">
            <div class="card rounded-lg p-4 text-center">
                <h3 class="card-title mb-4">Выход из системы</h3>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <p>Вы действительно хотите выйти?</p>
                    <form class="d-inline-flex justify-content-center"
                          asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          method="post">
                        <button type="submit" class="btn btn-delete">Выйти</button>
                    </form>
                }
                else
                {
                    <p>Вы успешно вышли из системы.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-go-to">На главную</a>
                }
            </div>
        </div>
    </div>
</div>