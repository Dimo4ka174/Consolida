# ============================================================
# Consolida — пример переменных окружения
# Скопируйте в .env и заполните реальными значениями.
# ============================================================

# ---------- ASP.NET Core ----------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ---------- PostgreSQL (обязательно) ----------
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=consolida;Username=postgres;Password=CHANGE_ME
POSTGRES_DB=consolida
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Redis (опционально) ----------
# Если REDIS_HOST пусто — используется in-memory кэш.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INSTANCE_NAME=Consolida_

# ---------- Data Protection ----------
# Каталог для ключей шифрования. Должен быть volume,
# иначе ключи потеряются при рестарте контейнера.
DATA_PROTECTION_PATH=/app/DataProtection-Keys

# ---------- Email (SMTP, опционально) ----------
# В Development письма НЕ отправляются — только логируются.
# Без SmtpServer DeliveryNotificationJob залогирует warning и пропустит итерацию.
EmailSettings__SmtpServer=
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=
EmailSettings__SmtpPassword=
EmailSettings__FromEmail=
EmailSettings__ToEmail=

# ---------- Serilog ----------
# Verbose, Debug, Information, Warning, Error, Fatal
SERILOG_MINIMUM_LEVEL=Information

# ---------- Hangfire ----------
# Пароль для dashboard. Пусто — доступ только с localhost.
HANGFIRE_DASHBOARD_USER=
HANGFIRE_DASHBOARD_PASSWORD=